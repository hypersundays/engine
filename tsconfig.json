{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "famous": ["dist/types/index.d.ts"],
      "famous/*": ["dist/types/*"]
    },
    "lib": ["ES2020", "DOM"]
  },
  "include": ["test/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
