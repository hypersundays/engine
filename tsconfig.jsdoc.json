{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "core/Clock.js",
    "core/Path.js",
    "render-loops/Scheduler.js",
    "utilities/clamp.js",
    "utilities/keyValueToArrays.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
