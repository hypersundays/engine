    },
    "./webgl-renderers": {
      "types": "./dist/types/webgl-renderers/index.d.ts",
      "import": "./dist/esm/webgl-renderers/index.js",
      "require": "./dist/cjs/webgl-renderers/index.cjs"
    },
    "./webgl-renderers/*": {
      "types": "./dist/types/webgl-renderers/*.d.ts",
      "import": "./dist/esm/webgl-renderers/*.js",
      "require": "./dist/cjs/webgl-renderers/*.cjs"
    },
    "./webgl-shaders": {
      "types": "./dist/types/webgl-shaders/index.d.ts",
      "import": "./dist/esm/webgl-shaders/index.js",
