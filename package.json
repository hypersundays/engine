  },
  "files": [
    "dist",
    "glsl.d.ts",
    "README.md",
    "LICENSE",
    "AUTHORS.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist coverage playwright-report test-results",
    "build": "npm run clean && vite build && npm run build:types",
    "build:types": "node ./scripts/build-types.js",
    "demo:dev": "npm run build && vite --config demo/vite.config.js",
    "demo:build": "npm run build && vite build --config demo/vite.config.js",
    "demo:preview": "vite preview --config demo/vite.config.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "npm run build:types && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.jsdoc.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Famous/engine.git"
  },
  "author": "Famous",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@rollup/plugin-commonjs": "^29.0.2",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-glslify": "^2.3.0",
    "vitest": "^4.1.0"
  }
}
